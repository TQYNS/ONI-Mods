<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 版本单一来源：改这里，程序集名 / 文件名 / AssemblyInfo 一起变 -->
  <PropertyGroup>
    <FrameworkMajor>1</FrameworkMajor>
    <FrameworkMinor>0</FrameworkMinor>
    <FrameworkPatch>0</FrameworkPatch>
    <FrameworkBuild>0</FrameworkBuild>
    <FrameworkVersionDotted>$(FrameworkMajor).$(FrameworkMinor).$(FrameworkPatch).$(FrameworkBuild)</FrameworkVersionDotted>
    <FrameworkVersionToken>$(FrameworkMajor)_$(FrameworkMinor)_$(FrameworkPatch)</FrameworkVersionToken>
    <FrameworkImplName>EventFramework.Impl.$(FrameworkVersionToken)</FrameworkImplName>
    <FrameworkArtifactsRoot>$(MSBuildThisFileDirectory)artifacts\</FrameworkArtifactsRoot>
  </PropertyGroup>
  <!-- 老式 csproj 不自动生成 AssemblyInfo，这里补一个只含版本的源文件 -->
  <Target Name="GenerateFrameworkVersionInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_FrameworkVersionInfoFile>$(IntermediateOutputPath)$(AssemblyName).VersionInfo.cs</_FrameworkVersionInfoFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_FrameworkVersionInfoFile)" Overwrite="true"
      Lines="using System.Reflection%3B;[assembly: AssemblyVersion(&quot;$(FrameworkVersionDotted)&quot;)];[assembly: AssemblyFileVersion(&quot;$(FrameworkVersionDotted)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(_FrameworkVersionInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
